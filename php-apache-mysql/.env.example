# ─────────────────────────────────────────────────────────────
#  Plantilla de variables — Stack PHP + Apache + MySQL
#
#  Uso:
#     cp .env.example .env
#     chmod 600 .env
#
#  Este fichero SÍ se sube al repositorio. El .env NO (está en
#  .gitignore y en .dockerignore).
#
#  Generate los secretos con:
#     openssl rand -hex 32      # usuario de aplicación
#     openssl rand -hex 32      # usuario root de MySQL
#
#  Son dos invocaciones DISTINTAS: nunca reutilices la misma.
#  No los escribas a mano ni los pegues en el README ni en un commit.
# ─────────────────────────────────────────────────────────────

# Contraseña del usuario de la aplicación (NO root).
DB_PASSWORD=cambiame_openssl_rand_hex_32

# Contraseña del usuario root de MySQL. Solo se usa durante el
# arranque inicial del contenedor.
DB_ROOT_PASSWORD=cambiame_openssl_rand_hex_32_diferente

# Base de datos y usuario creados en el primer arranque.
DB_NAME=appdb
DB_USER=appuser

# Zona horaria del contenedor.
TZ=Europe/Madrid

# Poner a 1 solo para depurar en local. Con 1 se expone la
# configuración completa de PHP, incluidas las variables de
# entorno con las contraseñas de la base de datos.
# NUNCA debe ser 1 en un entorno accesible desde la red.
PHPINFO=0
