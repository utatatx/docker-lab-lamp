# ─────────────────────────────────────────────────────────────
#  Plantilla de variables — Reverse proxy Caddy
#
#  Uso:
#     cp .env.example .env
#     chmod 600 .env
#
#  Este fichero SÍ se sube al repositorio. El .env NO.
#
#  ATENCIÓN: el servicio usa `env_file:` (no interpolación), así
#  que los hashes bcrypt con carácter '$' se copian tal cual.
# ─────────────────────────────────────────────────────────────

# Dominio que sirve Caddy.
DOMAIN=php.lab.local

# Modo de TLS:
#   internal -> CA propia de Caddy, autofirmada. Para laboratorio.
#              El navegador avisará hasta que confíes en la CA.
#   (vacío)  -> ACME / Let's Encrypt. Exige un dominio real que
#              resuelva a este servidor y puertos 80/443 abiertos
#              a Internet.
TLS_MODE=internal

# Correo para los avisos de caducidad de ACME. Sin efecto si
# TLS_MODE=internal.
ACME_EMAIL=admin@example.com

# ── Acceso a phpMyAdmin ─────────────────────────────────────
# Hostname propio para phpMyAdmin. Debe resolverse a la IP de
# este servidor igual que DOMAIN (fichero /etc/hosts o Pi-hole).
PMA_DOMAIN=phpmyadmin.lab.local

# phpMyAdmin se publica por Caddy con autenticación básica.
#
# Genera el hash bcrypt de la contraseña (NO la contraseña):
#     docker run --rm caddy caddy hash-password --plaintext 'TU_CONTRASEÑA'
#
# IMPORTANTE — las comillas simples son obligatorias:
# Compose trata el '$' inicial de una variable como inicio de
# interpolación, así que un hash escrito sin comillas se
# TRUNCA en el primer carácter '$' y el login falla. Solo
# funcionan 'comillas simples' o $$dolar$$dolar.
#
# Se deja VACÍA a propósito. Sin valor, Caddy se niega a
# arrancar con un error explícito:
#     "basic_auth: username and password cannot be empty or missing"
# No escribas aquí un texto de relleno: Caddy no lo reconocería
# como bcrypt e intentaría decodificarlo en base64, dando un
# error mucho más difícil de interpretar.
PM_USER=admin
PM_HASH=''
